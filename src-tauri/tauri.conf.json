{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinShell",
  "version": "0.1.1",
  "identifier": "dev.pinshell.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PinShell",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#0b0e14",
        "theme": "Dark",
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/integration/pinshell.ps1": "integration/pinshell.ps1",
      "../scripts/integration/pinshell.bash": "integration/pinshell.bash"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyQ0U1RENDRjZGMzEwNjcKUldSbkVQUDJ6RjNPQWpoV0lMVG0wRzZJbm92MmFndDlPUzRjTy9meVJaTEt0NkFYT2t5VzQzM2sK",
      "endpoints": [
        "https://github.com/ixuhan/PinShell/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
