{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinShell",
  "version": "0.1.0",
  "identifier": "dev.pinshell.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PinShell",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../scripts/integration/pinshell.ps1": "integration/pinshell.ps1",
      "../scripts/integration/pinshell.bash": "integration/pinshell.bash"
    }
  }
}
